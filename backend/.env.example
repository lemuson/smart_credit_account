# PostgreSQL: эти переменные используются как локальным приложением, так и Docker Compose.
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Необязательный полный DSN для запуска БЕЗ Docker (имеет приоритет над POSTGRES_*):
# DATABASE_URL=postgresql+psycopg://user:percent-encoded-password@localhost:5432/credit
# Сгенерируйте оба секрета независимо: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
TOKEN_MINUTES=60
MAX_DOCUMENT_BYTES=10485760
API_PORT=8000

# AI bridge (root ./start.sh generates the shared service credential)
AI_ENABLED=false
AI_SERVICE_TOKEN=
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Необязательные переменные Ollama (по умолчанию поднимается контейнер ollama в Docker):
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
