# PostgreSQL: эти переменные используются как локальным приложением, так и Docker Compose.
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Необязательный полный DSN для запуска БЕЗ Docker (имеет приоритет над POSTGRES_*):
# DATABASE_URL=postgresql+psycopg://user:percent-encoded-password@localhost:5432/credit
# Сгенерируйте оба секрета независимо: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
TOKEN_MINUTES=60
MAX_DOCUMENT_BYTES=10485760
API_PORT=8000
