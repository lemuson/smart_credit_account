ENVIRONMENT=development
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOOL_ROUNDS=4
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AI_WORKER_CONCURRENCY=1
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_MAX_ATTEMPTS=3
RABBITMQ_RETRY_DELAY_MS=5000
BACKEND_BASE_URL=http://localhost:8090
BACKEND_SERVICE_TOKEN=development-service-token
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=credit_knowledge
KNOWLEDGE_BASE_PATH=./knowledge_base
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.65
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_CHARS=16000

